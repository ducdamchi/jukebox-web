# =============================================================================
# Jukebox Web — Production Environment
# =============================================================================
# Copy this to .env.production.local and fill in your values.
# .env.production.local is gitignored and will override these defaults.
# Vite exposes VITE_* variables to the client bundle.

# -----------------------------------------------------------------------------
# Spotify Web Playback SDK & API
# -----------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard
# IMPORTANT: The redirect URI must match EXACTLY what is registered in Spotify Dashboard
# IMPORTANT: Spotify Web Playback SDK requires HTTPS in production.
#   - If serving via Fully Kiosk Browser on 127.0.0.1, configure it to allow HTTP
#   - Or use a self-signed cert / tunnel (e.g. ngrok) for HTTPS
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=https://your-kiosk-domain.local/callback
VITE_SPOTIFY_PLAYLIST_ID=

# Scopes required for Web Playback SDK + user info
VITE_SPOTIFY_SCOPES=streaming user-read-email user-read-private

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Max plays per barcode per day
VITE_DAILY_PLAY_LIMIT=3

# Number of song choices shown on the select screen
VITE_SONG_CHOICES_COUNT=4

# Idle timeout before returning to scan screen (ms)
VITE_IDLE_RETURN_TIMEOUT_MS=30000
