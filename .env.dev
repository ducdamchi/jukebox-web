# =============================================================================
# Jukebox Web — Development Environment
# =============================================================================
# Copy this to .env.development.local and fill in your values.
# .env.development.local is gitignored and will override these defaults.
# Vite exposes VITE_* variables to the client bundle.

# -----------------------------------------------------------------------------
# Spotify Web Playback SDK & API
# -----------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard
# Add http://127.0.0.1:5173/callback as a Redirect URI in the app settings
VITE_SPOTIFY_CLIENT_ID=cf4a60f63e9a44c4a339d36fbfdffe96
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
VITE_SPOTIFY_PLAYLIST_ID=1zAfIEwhiT8UUvUNpxJVAT
